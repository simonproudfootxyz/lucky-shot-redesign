---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import PortfolioImage from '../components/PortfolioImage.astro';
import { portfolioImages, aboutImage, portfolioThumbnail } from '../data/site';
const thumbnails = {
  signs: portfolioThumbnail(portfolioImages.signs),
  chalkboards: portfolioThumbnail(portfolioImages.chalkboards),
  branding: portfolioThumbnail(portfolioImages.branding),
  murals: portfolioThumbnail(portfolioImages.murals),
};
---
<BaseLayout title="Lucky Shot Studio | Signwriting, Murals & Design" description="Handpainted signs, chalkboards, murals and practical design services for hospitality, retail and independent brands.">
  <section class="hero">
    <div class="shell">
      <div class="hero-grid">
        <div class="hero-copy">
          <div>
            <div class="caps">Independent signage + design studio</div>
            <h1>Lucky Shot Studio</h1>
            <h2>You only get one shot to make a first impression</h2>
            <p>On a mission to put the <code>fun</code> in functional design</p>
            <div class="hero-ctas">
              <a class="btn fill" href="#work">See the work ↓</a>
              <a class="btn" href="/contact/">Start a project →</a>
            </div>
          </div>
          <div class="caps location">Nelson, New Zealand · Available for projects near + far</div>
        </div>
        <div class="hero-image" style={`background-image: url('${portfolioImages.signs[0].src}')`}>
          <!-- <PortfolioImage image={portfolioImages.murals[2]} loading="eager" fetchpriority="high" /> -->
          <div class="stamp">Painted &amp;<br />designed<br />by hand</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <div class="caps">Services</div>
        <h2>What can we make for you?</h2>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <section class="portfolio" id="work">
    <div class="shell">
      <div class="section-head">
        <div class="caps">Selected work</div>
        <h2>Seen around town.</h2>
      </div>
      <div class="portfolio-grid">
        <div class="left">
          <a class="frame one" href="/signs/" style={`background-image: url('${thumbnails.signs.src}')`}>
            <span class="label">Signs</span>
          </a>
          <a class="frame two" href="/chalkboards/" style={`background-image: url('${thumbnails.chalkboards.src}')`}>
            <span class="label">Chalkboards</span>
          </a>
        </div>
        <div class="right">
          <a class="frame three" href="/branding-illustration/" style={`background-image: url('${thumbnails.branding.src}')`}>
            <span class="label">Branding + Illustration</span>
          </a>
          <a class="frame four" href="/murals/" style={`background-image: url('${thumbnails.murals.src}')`}>
            <span class="label">Murals</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
<style>
  @import './index.css';
</style>
