---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<BaseLayout title="About | Lucky Shot Studio" description="Meet the artist behind Lucky Shot Studio in Nelson, New Zealand.">
  <section class="about-hero">
    <div class="about-grid">
      <div class="photo">
        <img src="/images/about/7bf8f32c-c5e3-46e3-aa4c-1bc2e7c7a33d.jpg" alt="Artist behind Lucky Shot Studio" />
      </div>
      <div class="copy">
        <div class="caps">Meet the artist</div>
        <h1>Hi, I'm Sophie!</h1>
        <p>I'm a multidisciplinary visual artist specialising in handpainted signage. I use traditional fine art techniques and timeless design to ensure your brand tells its story</p>
        <p>When I'm not working on a creative project you can find me enjoying a nice coffee, hunting for weird little knicknacks at the thrift store, or fishing down at the beach</p>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
<style>
  @import './about.css';
</style>
