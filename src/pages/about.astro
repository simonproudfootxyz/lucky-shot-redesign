---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<BaseLayout title="About | Lucky Shot Studio" description="Meet the artist behind Lucky Shot Studio in Nelson, New Zealand.">
  <section class="about-hero">
    <div class="about-grid">
      <div class="photo">
        <img src="/images/about/7bf8f32c-c5e3-46e3-aa4c-1bc2e7c7a33d.jpg" alt="Artist behind Lucky Shot Studio" />
      </div>
      <div class="copy">
        <div class="caps">Meet the artist</div>
        <h1>One person. A wide brush.</h1>
        <p>Lucky Shot Studio brings together traditional signwriting, hand-painted artwork and practical design services for businesses, venues and independent brands.</p>
        <p>This first build keeps the About copy intentionally concise until the client's final biography and studio story are supplied.</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell values">
      <div class="caps">The approach</div>
      <div class="value-grid">
        <article>
          <span>01</span>
          <h2>Direct</h2>
          <p>Clients work with the person making the work, from early idea through to final delivery.</p>
        </article>
        <article>
          <span>02</span>
          <h2>Practical</h2>
          <p>The work has to suit the real space, audience, format and business need—not just look good in a mockup.</p>
        </article>
        <article>
          <span>03</span>
          <h2>Made with character</h2>
          <p>Craft and personality stay visible, whether the final piece lives on a wall, a board, a package or a screen.</p>
        </article>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
<style>
  @import './about.css';
</style>
