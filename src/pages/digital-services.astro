---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
---
<BaseLayout title="Digital Services | Lucky Shot Studio" description="Practical digital design packages for independent businesses and brands.">
  <section class="digital-hero">
    <div class="shell">
      <div class="caps">Digital services</div>
      <h1>Good design, without the agency fog.</h1>
      <p>Flexible design support for businesses that need useful, professional visual work without turning every job into a full rebrand.</p>
      <a class="btn fill" href="/contact/">Talk about a project →</a>
    </div>
  </section>
  <section class="packages">
    <div class="shell">
      <div class="section-head">
        <div class="caps">Packages</div>
        <h2>A clear place to start.</h2>
      </div>
      <div class="package-grid">
        <article>
          <div class="caps">First Shot</div>
          <h3>Essentials</h3>
          <p>For straightforward design jobs with a clear brief and focused deliverables.</p>
          <ul>
            <li>Useful for single-piece design work</li>
            <li>Clear scope and agreed deliverables</li>
            <li>Final files supplied ready to use</li>
          </ul>
          <a href="/contact/">Enquire ↗</a>
        </article>
        <article class="featured">
          <div class="caps">On the Mark</div>
          <h3>More Room</h3>
          <p>For projects that need more exploration, more assets, or a fuller set of collateral.</p>
          <ul>
            <li>Multiple related design pieces</li>
            <li>More concept development</li>
            <li>Consistent visual direction across assets</li>
          </ul>
          <a href="/contact/">Enquire ↗</a>
        </article>
        <article>
          <div class="caps">Sure Shot</div>
          <h3>Complete</h3>
          <p>For larger packages and businesses that need a more cohesive set of brand applications.</p>
          <ul>
            <li>Broader visual system</li>
            <li>Multiple brand applications</li>
            <li>Designed for ongoing use</li>
          </ul>
          <a href="/contact/">Enquire ↗</a>
        </article>
      </div>
      <p class="placeholder-note">Package names, final prices, exact inclusions and FAQs can be replaced with the client's approved copy without changing this structure.</p>
    </div>
  </section>
  <section class="use-cases">
    <div class="shell">
      <div class="section-head">
        <div class="caps">Useful for</div>
        <h2>Practical design support where your brand actually shows up.</h2>
      </div>
      <div class="use-grid">
        <span>Menus</span>
        <span>Social graphics</span>
        <span>Print collateral</span>
        <span>Posters</span>
        <span>Promotional artwork</span>
        <span>Digital assets</span>
        <span>Packaging</span>
        <span>Brand applications</span>
      </div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
<style>
  @import './digital-services.css';
</style>
