---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import IndividualService from '../components/IndividualService.astro';

const individualServices = [
  { name: 'Logo design', price: '$500', note: '2 concepts · 1 revision' },
  { name: 'Logo design', price: '$850', note: '3 concepts · 2 revisions' },
  { name: 'Monogram design', price: '$300' },
  { name: 'Business card design', price: '$250–500' },
  { name: 'Brand guidelines document', price: '$1000–$2000' },
  { name: 'Illustrations', price: '$400–$1500', note: 'Price varies with detail and usage' },
  { name: 'Hourly signage design rate', price: '$150' },
  { name: 'Hourly graphic design rate', price: '$50' },
  { name: 'Chalkboards A1 size', price: '$150–350' },
  { name: 'Menu boards', price: '$800–2000' },
  { name: 'Murals', price: '$150/sqm' },
];
---
<BaseLayout title="Digital Services | Lucky Shot Studio" description="Practical digital design packages for independent businesses and brands.">
  <section class="digital-hero">
    <div class="shell">
      <div class="caps">Digital services</div>
      <h1>Good design, great vibes</h1>
      <p>Design support for businesses that need useful, tasteful, and professional visual materials</p>
      <a class="btn fill" href="/contact/">Talk about a project →</a>
    </div>
  </section>
  <section class="packages">
    <div class="shell">
      <div class="section-head">
        <div class="caps">Packages</div>
        <h2>A clear place to start.</h2>
      </div>
      <div class="package-grid">
        <article>
          <div class="caps">Essentials</div>
          <h3>First Shot</h3>
          <p>$800</p>
          <ul>
            <li>Primary logo</li>
            <li>2 revisions</li>
            <li>Colour palette</li>
            <li>Business card design</li>
            <li>Typography</li>
          </ul>
          <a href="/contact/">Enquire &nearr;</a>
        </article>
        <article class="featured">
          <div class="caps">More Room</div>
          <h3>On the Mark</h3>
          <p>$1500</p>
          <ul>
            <li>Primary logo</li>
            <li>3 revisions</li>
            <li>2 logo variations</li>
            <li>Business card design</li>
            <li>Typography</li>
            <li>Basic brand guidelines</li>
            <li>Social media launch templates</li>
            <li>Custom colour palette</li>
          </ul>
          <a href="/contact/">Enquire &nearr;</a>
        </article>
        <article>
          <div class="caps">Complete</div>
          <h3>Sure Shot</h3>
          <p>$3000</p>
          <ul>
            <li>Full logo suite</li>
            <li>Brand identity system</li>
            <li>Business card design</li>
            <li>Custom colour palette</li>
            <li>Typography system</li>
            <li>Social media launch templates</li>
            <li>Brand pattern & graphic elements</li>
            <li>Brand strategy (vision &amp; voice)</li>
            <li>Complete brand identity</li>
          </ul>
          <a href="/contact/">Enquire &nearr;</a>
        </article>
      </div>
    </div>
  </section>
  <section class="use-cases">
    <div class="shell">
      <div class="section-head">
        <div class="caps">A la carte</div>
        <h2>Individual services</h2>
      </div>
      <ul class="individual-services">
        {individualServices.map((service) => (
          <li>
            <IndividualService name={service.name} price={service.price} note={service.note} />
          </li>
        ))}
      </ul>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
<style>
  @import './digital-services.css';
</style>
